# Copy to .env.services only after the image digests have been verified.
# Mutable tags such as latest or main are deliberately rejected by preflight.
JOSIE_STORAGE=D:/Josie-Storage
JOSIE_TIMEZONE=America/New_York
N8N_IMAGE=docker.n8n.io/n8nio/n8n:REPLACE_WITH_VERSION@sha256:REPLACE_WITH_DIGEST
OPEN_WEBUI_IMAGE=ghcr.io/open-webui/open-webui:REPLACE_WITH_VERSION@sha256:REPLACE_WITH_DIGEST
PLAYWRIGHT_IMAGE=mcr.microsoft.com/playwright:v1.62.0-noble@sha256:REPLACE_WITH_DIGEST
OPEN_WEBUI_ENABLE_SIGNUP=false
# Generated locally by Start-JosieProposalInterface.ps1 after explicit approval.
# Never paste a real bearer token into this tracked example.
JOSIE_TOOL_SERVER_CONNECTIONS=[]
# Set false for a reversible rollback of ordinary-chat identity injection.
JOSIE_IDENTITY_BOOTSTRAP_ENABLED=true
# Phase 2A read-only canonical/history evidence bridge. Disable to restore Phase 1 behavior.
JOSIE_HISTORY_CONTEXT_ENABLED=true
# Hard JSON evidence-packet ceiling (12,000 characters is roughly 3,000 tokens).
JOSIE_HISTORY_CONTEXT_MAX_CHARS=12000
