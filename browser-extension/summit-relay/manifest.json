{
    "manifest_version":  3,
    "name":  "Josie Summit Relay v0.1",
    "version":  "0.1.0",
    "description":  "Runs only the bounded, attributed Sophie/Bernie/Josie Summit Relay exchange.",
    "permissions":  [
                        "tabs",
                        "alarms"
                    ],
    "host_permissions":  [
                             "http://127.0.0.1:8792/*",
                             "https://chatgpt.com/*",
                             "https://gemini.google.com/*",
                             "http://localhost:3000/*",
                             "http://127.0.0.1:3000/*"
                         ],
    "background":  {
                       "service_worker":  "background.js"
                   },
    "content_scripts":  [
                            {
                                "run_at":  "document_idle",
                                "matches":  [
                                                "https://chatgpt.com/*",
                                                "https://gemini.google.com/*",
                                                "http://localhost:3000/*",
                                                "http://127.0.0.1:3000/*"
                                            ],
                                "js":  [
                                           "content.js"
                                       ]
                            }
                        ],
    "content_security_policy":  {
                                    "extension_pages":  "script-src \u0027self\u0027; object-src \u0027none\u0027"
                                }
}