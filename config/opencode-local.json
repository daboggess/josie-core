{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": [
    "ollama"
  ],
  "shell": "C:/Program Files/Git/bin/bash.exe",
  "model": "ollama/qwen3:14b",
  "small_model": "ollama/qwen3:14b",
  "autoupdate": false,
  "share": "disabled",
  "snapshot": false,
  "lsp": false,
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama local only",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      },
      "models": {
        "josie-qual-qwen3:8b-32k": {
          "name": "Qwen3 8B (qualified bounded proof)",
          "tool_call": true,
          "limit": {
            "context": 32768,
            "output": 2048
          }
        },
        "qwen3:14b": {
          "name": "qwen3:14b",
          "tool_call": true,
          "limit": {
            "context": 8192,
            "output": 2048
          },
          "options": {
            "reasoningEffort": "none"
          }
        },
        "gemma4:12b": {
          "name": "gemma4:12b",
          "tool_call": true,
          "limit": {
            "context": 8192,
            "output": 2048
          }
        },
        "qwen2.5-coder:14b": {
          "name": "qwen2.5-coder:14b",
          "tool_call": true,
          "limit": {
            "context": 8192,
            "output": 2048
          }
        }
      }
    }
  },
  "agent": {
    "josie-local": {
      "description": "Execute Dustin's bounded local repository task",
      "mode": "primary",
      "temperature": 0,
      "steps": 10,
      "prompt": "You are Josie's local coding worker. Execute the assigned task with actual tools. Do not merely describe commands. Work only in the current repository. Preserve unrelated edits. Never access credentials, historical or canonical data; never publish, purchase, change accounts or system configuration. Use bash for commands; this is Git Bash on Windows, so Python is .venv/Scripts/python.exe. After successful tool output, report actual results concisely. Never claim an action without a successful tool result.",
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "write": "allow",
        "edit": "allow",
        "apply_patch": "allow",
        "bash": "allow"
      }
    },
    "title": {
      "disable": true
    }
  }
}
